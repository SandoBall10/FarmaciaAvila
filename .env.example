# Copiar a .env en la raíz del repositorio.
# No usar estos valores en un despliegue real.

POSTGRES_DB=farmacia_avila
POSTGRES_USER=farmacia
POSTGRES_PASSWORD=cambiar_docker

JWT_SECRET=REPLACE_WITH_A_RANDOM_256_BIT_SECRET
JWT_EXPIRATION=3600000

# Origen del navegador (puerto publicado del frontend).
CORS_ALLOWED_ORIGINS=http://localhost:8080

# URL que usará el NAVEGADOR para hablar con el backend publicado.
# No usar el hostname interno "backend".
VITE_API_URL=http://localhost:8010
