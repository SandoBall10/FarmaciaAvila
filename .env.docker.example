# Copia de referencia para Docker Compose (equivalente a .env.example).
# Copiar a .env en la raíz. No versionar secretos reales.

POSTGRES_DB=farmacia_avila
POSTGRES_USER=farmacia
POSTGRES_PASSWORD=cambiar_docker
JWT_SECRET=REPLACE_WITH_A_RANDOM_256_BIT_SECRET
JWT_EXPIRATION=3600000
CORS_ALLOWED_ORIGINS=http://localhost:8080
VITE_API_URL=http://localhost:8010
